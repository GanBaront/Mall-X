# Mall-X 本地配置模板
# 用法：复制本文件为 .env，填入自己的值。.env 已被 .gitignore 排除，绝不会入库。
# 下面全部是占位值或本地演示值，不含任何真实凭据。
#
# 后端双击 backend/启动后端.bat 时会自动读取本文件；
# docker compose 也会自动读取项目根的 .env。

# JWT 签名密钥：建议 48 字节以上随机串。三个模块必须使用同一个值。
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
MALL_JWT_SECRET=replace-with-your-own-random-string

# 业务接口 MD5 签名密钥（mall.sign.required=true 时生效）
MALL_SIGN_KEY=replace-with-your-own-random-string

# 本机 MySQL 口令（仅本地演示库）
MALL_DB_PASSWORD=123456

# 网关自签证书库口令，需与 backend/gen-ssl-cert.bat 中的 PASS 一致
MALL_SSL_PASSWORD=MallXGw2026Local

# ===== 支付宝沙箱（可选）=====
# 留空 = 使用内置模拟收银台，不影响课程演示。
# 如需真实沙箱支付，请在沙箱控制台获取后填入，切勿写进 application.yml。
ALIPAY_APP_ID=
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
